<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Coverage scoped to the target assembly only (gate lives in tests/Directory.Build.props) -->
    <Include>[CoreBankDemo.ServiceDefaults]*</Include>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CoreBankDemo.ServiceDefaults\CoreBankDemo.ServiceDefaults.csproj" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-022: the provisioned LGTM dashboard is checked against BusinessMetrics
         instrument names so a renamed instrument fails the build, not a panel. -->
    <Content Include="..\..\observability\grafana\dashboards\corebank.json" Link="Dashboards\corebank.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The traces dashboard is the Grafana home page; both AppHosts are linked so the
         home-dashboard path they set is checked against the provisioned file name. -->
    <Content Include="..\..\observability\grafana\dashboards\corebank-traces.json" Link="Dashboards\corebank-traces.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\CoreBankDemo.AppHost\AppHost.cs" Link="AppHosts\CoreBankDemo.AppHost\AppHost.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\CoreBankDemo.LoadTests\AppHost.cs" Link="AppHosts\CoreBankDemo.LoadTests\AppHost.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- Idle poll ticks must not log: the EF Core command category is pinned at Warning. -->
    <Content Include="..\..\CoreBankDemo.PaymentsAPI\appsettings.json" Link="Services\CoreBankDemo.PaymentsAPI\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\CoreBankDemo.CoreBankAPI\appsettings.json" Link="Services\CoreBankDemo.CoreBankAPI\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- ADR-025: the LGTM component configs both AppHosts mount over the image's own are
         checked for their one-day retention so a re-sync after an image bump cannot drop it. -->
    <Content Include="..\..\observability\lgtm\tempo-config.yaml" Link="Lgtm\tempo-config.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\observability\lgtm\loki-config.yaml" Link="Lgtm\loki-config.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\observability\lgtm\prometheus.yaml" Link="Lgtm\prometheus.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
