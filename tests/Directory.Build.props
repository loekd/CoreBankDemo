<Project>
  <!-- Chain to a repo-root Directory.Build.props if one ever exists (none today) -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" Condition="Exists($([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../')))" />

  <!-- Shared settings for all projects under tests/.
       Coverage gate: coverlet.msbuild fails plain `dotnet test` below 90% line coverage.
       Runner mode: VSTest (xunit.runner.visualstudio + Microsoft.NET.Test.Sdk).
       Never enable Microsoft.Testing.Platform here — coverlet.msbuild enforcement
       does not run under MTP and the gate would silently vanish. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>


  <!-- ADR-016 tier split, single source of truth.
       These are the provider-sensitive persistence adapters: EF Core contexts,
       repositories/durable stores, the demo seeder, and the hosted processors
       whose behavior is only observable against a real database. They are
       covered by tests/CoreBankDemo.Persistence.IntegrationTests (PostgreSQL
       Testcontainers) and therefore measured there rather than by the
       Docker-free unit tier. This is a tier assignment, not an exclusion: every
       type below is still gated at >=90%, both tiers run in the full rebuild
       gate, and no broad [ExcludeFromCodeCoverage] attribute is used to make the
       split pass. Forgetting to list a new persistence adapter here simply
       leaves the unit tier measuring it — the gate never gets quietly weaker. -->
  <PropertyGroup>
    <PersistenceTierFilters>[CoreBankDemo.Messaging]CoreBankDemo.Messaging.MessageRepositoryBase*,[CoreBankDemo.Messaging]CoreBankDemo.Messaging.InboxMessageRepositoryBase*,[CoreBankDemo.Messaging]CoreBankDemo.Messaging.OutboxMessageRepositoryBase*,[CoreBankDemo.CoreBankAPI]CoreBankDemo.CoreBankAPI.CoreBankDbContext*,[CoreBankDemo.CoreBankAPI]CoreBankDemo.CoreBankAPI.CoreBankDatabaseInitializer*,[CoreBankDemo.CoreBankAPI]CoreBankDemo.CoreBankAPI.DemoAccountSeeder*,[CoreBankDemo.CoreBankAPI]CoreBankDemo.CoreBankAPI.Inbox.AccountRepository*,[CoreBankDemo.CoreBankAPI]CoreBankDemo.CoreBankAPI.Inbox.InboxMessageRepository*,[CoreBankDemo.CoreBankAPI]CoreBankDemo.CoreBankAPI.Inbox.InboxProcessor*,[CoreBankDemo.CoreBankAPI]CoreBankDemo.CoreBankAPI.Inbox.TransactionExecutionHandler*,[CoreBankDemo.CoreBankAPI]CoreBankDemo.CoreBankAPI.Outbox.MessagingOutboxProcessor*,[CoreBankDemo.CoreBankAPI]CoreBankDemo.CoreBankAPI.Outbox.MessagingOutboxRepository*,[CoreBankDemo.CoreBankAPI]CoreBankDemo.CoreBankAPI.Outbox.OutboxEventEnqueuer*,[CoreBankDemo.PaymentsAPI]CoreBankDemo.PaymentsAPI.PaymentsDbContext*,[CoreBankDemo.PaymentsAPI]CoreBankDemo.PaymentsAPI.PaymentsDatabaseInitializer*,[CoreBankDemo.PaymentsAPI]CoreBankDemo.PaymentsAPI.Inbox.InboxMessageRepository*,[CoreBankDemo.PaymentsAPI]CoreBankDemo.PaymentsAPI.Inbox.InboxProcessor*,[CoreBankDemo.PaymentsAPI]CoreBankDemo.PaymentsAPI.Outbox.OutboxRepository*,[CoreBankDemo.PaymentsAPI]CoreBankDemo.PaymentsAPI.Outbox.PaymentsOutboxProcessor*,[CoreBankDemo.LoadTestSupport]CoreBankDemo.LoadTestSupport.LoadTestDatabaseResetter*</PersistenceTierFilters>
  </PropertyGroup>

  <!-- Runner + gate apply only to test projects (name ends in "Tests");
       helper libraries under tests/ stay plain class libraries. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <!-- Shared project settings for all test projects -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keep MTP disabled: xunit.v3 4.x defaults this to true, and on .NET 10 SDK
         the MTP MSBuild targets then hard-error under the VSTest target.
         false = stay on VSTest; this is a disable, not an MTP opt-in. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <!-- coverlet.msbuild enforcement -->
    <CollectCoverage>true</CollectCoverage>
    <Threshold>90</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>minimum</ThresholdStat>
    <ExcludeByAttribute>ExcludeFromCodeCoverage,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
    <Exclude>[*]*.Program,[*]Program</Exclude>
    <!-- Each test project must set <Include> filters scoped to its target assembly
         (story 1.2 does this) so transitive assemblies don't fail the gate. -->
  </PropertyGroup>


  <!-- Tier 1 (Docker-free unit tests): measure everything the tier owns, minus
       the persistence adapters tier 2 owns. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests')) AND '$(MSBuildProjectName)' != 'CoreBankDemo.Persistence.IntegrationTests'">
    <Exclude>$(Exclude),$(PersistenceTierFilters)</Exclude>
  </PropertyGroup>

  <!-- Tier 2 (PostgreSQL Testcontainers): measure exactly those persistence
       adapters, at the same >=90% threshold. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'CoreBankDemo.Persistence.IntegrationTests'">
    <Include>$(PersistenceTierFilters)</Include>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <!-- Versions pinned centrally in Directory.Packages.props -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Moq" />
    <!-- coverlet.msbuild alone owns the gate; coverlet.collector stays pinned centrally
         and is opt-in per project (avoids double instrumentation when the VSTest
         "XPlat Code Coverage" data collector is also requested). -->
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
