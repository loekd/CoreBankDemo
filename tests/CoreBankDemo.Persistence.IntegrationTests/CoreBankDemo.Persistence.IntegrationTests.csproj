    <ProjectReference Include="..\..\CoreBankDemo.LoadTestSupport\CoreBankDemo.LoadTestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions pinned centrally in Directory.Packages.props. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.XunitV3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

</Project>
