<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- LoadTestAssertionService itself is EF-backed (CoreBankDbContext/
         PaymentsDbContext constructor deps) and is measured by the
         persistence integration tier instead, via $(PersistenceTierFilters)
         in tests/Directory.Build.props — only its pure, Docker-free half
         (LoadTestAssertionCalculator) belongs to this project's filter. -->
    <Include>[CoreBankDemo.LoadTestSupport]CoreBankDemo.LoadTestSupport.DatabaseResetCoordinator*,[CoreBankDemo.LoadTestSupport]CoreBankDemo.LoadTestSupport.Services.LoadTestAssertionCalculator*,[CoreBankDemo.LoadTestSupport]CoreBankDemo.LoadTestSupport.Services.LoadRunEvidenceState*</Include>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CoreBankDemo.LoadTestSupport\CoreBankDemo.LoadTestSupport.csproj" />
  </ItemGroup>

</Project>
