{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OutboxProcessing": {
    "PartitionCount": 4,
    "LockExpirySeconds": 30,
    "PollingIntervalMs": 200
  },
  "InboxProcessing": {
    "PartitionCount": 4,
    "LockExpirySeconds": 30,
    "PollingIntervalMs": 200
  },
  "Payments": {
    "InstantRail": {
      "Enabled": true,
      "BudgetMilliseconds": 9000,
      "AttemptTimeoutMilliseconds": 2500,
      "MaxAttempts": 2
    }
  }
}
