@CoreBankDemo_HostAddress = http://localhost:5294

# Demo payment with fixed idempotency key - run multiple times to test deduplication
POST {{CoreBankDemo_HostAddress}}/api/payments
Content-Type: application/json
Idempotency-Key: regular-apphost-demo-payment-v1

{
  "fromAccount": "NL91ABNA0417164300",
  "toAccount": "NL20INGB0001234567",
  "amount": 1.00,
  "currency": "EUR"
}

###

# Check if unique index exists on OutboxMessages (diagnostic endpoint)
GET {{CoreBankDemo_HostAddress}}/api/outbox/check-index
Accept: application/json

###
