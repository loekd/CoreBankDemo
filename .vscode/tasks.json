{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "build-apphost",
        "command": "dotnet",
        "type": "process",
        "args": [
            "build",
            "${workspaceFolder}/CoreBankDemo.AppHost/CoreBankDemo.AppHost.csproj",
            "--configuration",
            "Debug"
        ],
        "problemMatcher": "$msCompile",
        "group": {
            "kind": "build",
            "isDefault": true
        }
    },
    {
        "label": "build-demo-runner",
        "command": "dotnet",
        "type": "process",
        "args": [
            "build",
            "${workspaceFolder}/CoreBankDemo.DemoRunner/CoreBankDemo.DemoRunner.csproj",
            "--configuration",
            "Debug"
        ],
        "problemMatcher": "$msCompile"
    },
    {
        "label": "run-load-test-apphost",
        "command": "aspire",
        "type": "process",
        "args": [
            "start",
            "--apphost",
            "${workspaceFolder}/CoreBankDemo.LoadTests/CoreBankDemo.LoadTests.csproj",
            "--non-interactive"
        ],
        "problemMatcher": []
    }
]
}
