{
  "schemaVersion": 1,
  "name": "MissionCriticalTalk-v7",
  "scenarioVersion": "v7",
  "requiredProfile": "Regular",
  "cues": [
    {
      "id": "pre-show-doctor",
      "slideAnchor": "pre-show",
      "title": "Pre-show doctor",
      "speakerNote": "Confirm the regular topology is up before the talk starts. This never fires during the talk itself.",
      "preArmActions": [],
      "actions": [
        { "kind": "selectTopology", "profileName": "Regular" },
        { "kind": "waitForHealth", "resourceName": "payments-api", "timeoutSeconds": 60 },
        { "kind": "waitForHealth", "resourceName": "corebank-api", "timeoutSeconds": 60 },
        { "kind": "waitForHealth", "resourceName": "jaeger", "timeoutSeconds": 30 }
      ],
      "investigateActions": [
        { "kind": "openKnownUrl", "linkId": "aspire-dashboard" }
      ]
    },
    {
      "id": "s42-inbox-at-work",
      "slideAnchor": "42",
      "title": "Inbox at work",
      "speakerNote": "Submit TALK-V7-INBOX-A, then retry the exact same command. Two accepted responses, one Inbox identity, one execution.",
      "preArmActions": [
        { "kind": "waitForHealth", "resourceName": "corebank-api", "timeoutSeconds": 15 }
      ],
      "actions": [
        {
          "kind": "sendHttp",
          "endpointId": "corebank.transactions.process",
          "method": "POST",
          "bodyJson": "{\"fromAccount\":\"NL91ABNA0417164300\",\"toAccount\":\"NL20INGB0001234567\",\"amount\":100.00,\"currency\":\"EUR\",\"transactionId\":\"{{IDEMPOTENCY_KEY}}\"}",
          "idempotencyKeyRef": "inbox-demo",
          "captureAs": "FirstTransactionId",
          "captureJsonPath": "$.transactionId"
        },
        {
          "kind": "sendHttp",
          "endpointId": "corebank.transactions.process",
          "method": "POST",
          "bodyJson": "{\"fromAccount\":\"NL91ABNA0417164300\",\"toAccount\":\"NL20INGB0001234567\",\"amount\":100.00,\"currency\":\"EUR\",\"transactionId\":\"{{IDEMPOTENCY_KEY}}\"}",
          "idempotencyKeyRef": "inbox-demo",
          "captureAs": "SecondTransactionId",
          "captureJsonPath": "$.transactionId"
        },
        {
          "kind": "assertHttp",
          "captureRefA": "FirstTransactionId",
          "captureRefB": "SecondTransactionId",
          "expectEqual": true
        }
      ],
      "investigateActions": [
        {
          "kind": "sendHttp",
          "endpointId": "corebank.transactions.status",
          "method": "GET",
          "pathParamRef": "FirstTransactionId"
        },
        { "kind": "openKnownUrl", "linkId": "jaeger" }
      ]
    },
    {
      "id": "s45-52-prove-it",
      "slideAnchor": "45-52",
      "title": "Proving everything works",
      "speakerNote": "Run the accepted Aspire/k6 load workflow: Run, Wait for drain, Assert all five invariants.",
      "preArmActions": [],
      "actions": [
        { "kind": "selectTopology", "profileName": "LoadTest" },
        { "kind": "waitForHealth", "resourceName": "loadtest-support", "timeoutSeconds": 90 },
        { "kind": "runAcceptedLoadWorkflow", "profileName": "LoadTest", "expectedUniqueCount": 100 }
      ],
      "investigateActions": [
        { "kind": "sendHttp", "endpointId": "loadtestsupport.corebank.inbox", "method": "GET" },
        { "kind": "openKnownUrl", "linkId": "jaeger" }
      ]
    },
    {
      "id": "s53-dev-environment-handoff",
      "slideAnchor": "53",
      "title": "Development-environment hand-off",
      "speakerNote": "Hand off to Dev Containers/Codespaces for anyone who wants to try the repo themselves.",
      "preArmActions": [],
      "actions": [
        { "kind": "openKnownUrl", "linkId": "repo-github" },
        { "kind": "openKnownUrl", "linkId": "devcontainer-docs" }
      ],
      "investigateActions": []
    }
  ]
}
