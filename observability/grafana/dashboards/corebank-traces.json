{
  "uid": "corebank-traces",
  "title": "CoreBank Traces",
  "description": "Jaeger-style trace search: pick a service and operation, see its rate, errors and p95 from span metrics, the matching end-to-end traces, and the service map. Grafana's home page (ADR-022).",
  "tags": [
    "corebank"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "CoreBank metrics",
      "type": "link",
      "url": "/d/corebank",
      "icon": "dashboard",
      "tooltip": "Detailed payments, CoreBank and Inbox/Outbox dashboard",
      "targetBlank": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "description": "Services that received requests or messages in the last 7 days (Tempo span metrics).",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(count by (service) (last_over_time(traces_spanmetrics_calls_total{span_kind!=\"SPAN_KIND_CLIENT\"}[7d])))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "query_result(count by (service) (last_over_time(traces_spanmetrics_calls_total{span_kind!=\"SPAN_KIND_CLIENT\"}[7d])))",
        "regex": "/service=\"(?<text>[^\"]+)\"/",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "CoreBank.PaymentsAPI",
          "value": "CoreBank.PaymentsAPI"
        },
        "options": []
      },
      {
        "name": "operation",
        "label": "Operation",
        "description": "Server, consumer and producer span names of the selected service; outgoing client calls (database, Redis, HTTP) are left out.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(count by (span_name) (last_over_time(traces_spanmetrics_calls_total{service=\"$service\", span_kind!=\"SPAN_KIND_CLIENT\"}[7d])))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "query_result(count by (span_name) (last_over_time(traces_spanmetrics_calls_total{service=\"$service\", span_kind!=\"SPAN_KIND_CLIENT\"}[7d])))",
        "regex": "/span_name=\"(?<text>[^\"]+)\"/",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "POST api/Payments",
          "value": "POST api/Payments"
        },
        "options": []
      },
      {
        "name": "outcome",
        "label": "Outcome",
        "description": "Custom metrics: the outcome tag. Each instrument has its own outcomes, so a value filters only the panels that use it; the others show no data.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(count by (outcome) (last_over_time({__name__=~\"corebankdemo_.+\", outcome!=\"\"}[7d])))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "query_result(count by (outcome) (last_over_time({__name__=~\"corebankdemo_.+\", outcome!=\"\"}[7d])))",
        "regex": "/outcome=\"(?<text>[^\"]+)\"/",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "payment_scheme",
        "label": "Payment scheme",
        "description": "Custom metrics: payment.intake scheme (standard, instant).",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(count by (payment_scheme) (last_over_time(corebankdemo_payment_intake_total[7d])))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "query_result(count by (payment_scheme) (last_over_time(corebankdemo_payment_intake_total[7d])))",
        "regex": "/payment_scheme=\"(?<text>[^\"]+)\"/",
        "refresh": 1,
