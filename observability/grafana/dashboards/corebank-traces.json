{
  "uid": "corebank-traces",
  "title": "CoreBank Traces",
  "description": "Jaeger-style trace search: pick a service and operation, see its rate, errors and p95 from span metrics, the matching end-to-end traces, and the service map. Below that, today's totals for the payment flow. Grafana's home page (ADR-022).",
  "tags": [
    "corebank"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "CoreBank metrics",
      "type": "link",
      "url": "/d/corebank",
      "icon": "dashboard",
      "tooltip": "Detailed payments, CoreBank and Inbox/Outbox dashboard",
      "targetBlank": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "description": "Services that received requests or messages in the last 7 days (Tempo span metrics).",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(count by (service) (last_over_time(traces_spanmetrics_calls_total{span_kind!=\"SPAN_KIND_CLIENT\"}[7d])))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "query_result(count by (service) (last_over_time(traces_spanmetrics_calls_total{span_kind!=\"SPAN_KIND_CLIENT\"}[7d])))",
        "regex": "/service=\"(?<text>[^\"]+)\"/",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "CoreBank.PaymentsAPI",
          "value": "CoreBank.PaymentsAPI"
        },
        "options": []
      },
      {
        "name": "operation",
        "label": "Operation",
        "description": "Server, consumer and producer span names of the selected service; outgoing client calls (database, Redis, HTTP) are left out.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(count by (span_name) (last_over_time(traces_spanmetrics_calls_total{service=\"$service\", span_kind!=\"SPAN_KIND_CLIENT\"}[7d])))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "query_result(count by (span_name) (last_over_time(traces_spanmetrics_calls_total{service=\"$service\", span_kind!=\"SPAN_KIND_CLIENT\"}[7d])))",
        "regex": "/span_name=\"(?<text>[^\"]+)\"/",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "POST api/Payments",
          "value": "POST api/Payments"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate",
      "description": "Spans per second for the selected operation, from Tempo span metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"$service\", span_name=\"$operation\"}[$__rate_interval]))",
          "legendFormat": "$operation",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors",
      "description": "Spans per second with error status for the selected operation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"$service\", span_name=\"$operation\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "errors",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 duration",
      "description": "95th percentile span duration for the selected operation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"$service\", span_name=\"$operation\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Traces",
      "description": "End-to-end traces containing the selected operation, newest first. Click a trace ID to open the full waterfall across PaymentsAPI, CoreBankAPI, Dapr and the events back.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Start time"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "limit": 50,
          "query": "{ resource.service.name = \"$service\" && name = \"$operation\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Traces with errors",
      "description": "Traces containing the selected operation and at least one span with error status.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Start time"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "limit": 50,
          "query": "{ resource.service.name = \"$service\" && name = \"$operation\" } && { status = error }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 6,
      "type": "nodeGraph",
      "title": "Service map",
      "description": "Calls between services in the selected time range, from Tempo's service graph. Database and Redis connections show as their host (localhost, 127.0.0.1).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 12
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Today",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Payments received",
      "description": "Payments PaymentsAPI stored today, each written to its transactional outbox in the same database transaction. Duplicates and validation failures are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 5
      },
      "timeFrom": "now/d",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum((last_over_time(corebankdemo_payment_intake_total{service_name=\"CoreBank.PaymentsAPI\", outcome=\"stored\"}[$__range]) - (corebankdemo_payment_intake_total{service_name=\"CoreBank.PaymentsAPI\", outcome=\"stored\"} offset $__range)) or last_over_time(corebankdemo_payment_intake_total{service_name=\"CoreBank.PaymentsAPI\", outcome=\"stored\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Transactions processed",
      "description": "Transactions CoreBank executed today, exactly once each: completed or rejected by a business rule. The result event is written to CoreBank's outbox in the same database transaction.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 5
      },
      "timeFrom": "now/d",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum((last_over_time(corebankdemo_transaction_processed_total{service_name=\"CoreBank.CoreBankAPI\"}[$__range]) - (corebankdemo_transaction_processed_total{service_name=\"CoreBank.CoreBankAPI\"} offset $__range)) or last_over_time(corebankdemo_transaction_processed_total{service_name=\"CoreBank.CoreBankAPI\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Messages sent",
      "description": "Result events (transaction-completed or transaction-failed) CoreBank's outbox published today, one per processed transaction. Equal to the other two totals unless there is an outage; a publish retried after a lost acknowledgement counts twice.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 5
      },
      "timeFrom": "now/d",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum((last_over_time(corebankdemo_messaging_deliveries_total{service_name=\"CoreBank.CoreBankAPI\", messaging_direction=\"sent\", outcome=\"succeeded\", messaging_message_type=~\"transaction-completed|transaction-failed\"}[$__range]) - (corebankdemo_messaging_deliveries_total{service_name=\"CoreBank.CoreBankAPI\", messaging_direction=\"sent\", outcome=\"succeeded\", messaging_message_type=~\"transaction-completed|transaction-failed\"} offset $__range)) or last_over_time(corebankdemo_messaging_deliveries_total{service_name=\"CoreBank.CoreBankAPI\", messaging_direction=\"sent\", outcome=\"succeeded\", messaging_message_type=~\"transaction-completed|transaction-failed\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    }
  ]
}
