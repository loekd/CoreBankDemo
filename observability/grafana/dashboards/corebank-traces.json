          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"$service\", span_name=\"$operation\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Traces",
      "description": "End-to-end traces containing the selected operation, newest first. Click a trace ID to open the full waterfall across PaymentsAPI, CoreBankAPI, Dapr and the events back.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Start time"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "limit": 50,
          "query": "{ resource.service.name = \"$service\" && name = \"$operation\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ]
    },
